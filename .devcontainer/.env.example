# Diese Datei nach ".env" kopieren und mit dem echten Bedrock API Key befuellen.
# .env selbst ist per .devcontainer/.gitignore vom Commit ausgeschlossen.
#
# Erzeugen: AWS Bedrock Console -> Model catalog / API keys
#           -> "Generate long-term API key" (oder short-term zum Testen).
#
# cp .devcontainer/.env.example .devcontainer/.env

AWS_BEARER_TOKEN_BEDROCK=<hier den Bedrock API Key eintragen>
